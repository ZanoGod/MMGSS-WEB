# =========================================================
# Myanmar GSS — Apache .htaccess
# Clean URLs + Static Site Hosting
# =========================================================

Options -MultiViews

# ---------------------------------------------------------
# MIME TYPES / UTF-8
# ---------------------------------------------------------

<IfModule mod_mime.c>
    AddDefaultCharset UTF-8

    AddType application/json .json
    AddType image/svg+xml .svg .svgz
    AddType application/javascript .js .mjs

    AddCharset UTF-8 .html
    AddCharset UTF-8 .css
    AddCharset UTF-8 .js
    AddCharset UTF-8 .json
</IfModule>


# ---------------------------------------------------------
# URL REWRITING
# ---------------------------------------------------------

<IfModule mod_rewrite.c>

    RewriteEngine On

    # -----------------------------------------------------
    # IMPORTANT:
    # This .htaccess is inside /myanmargss/
    #
    # /myanmargss/services
    #       ↓
    # /myanmargss/services.html
    # -----------------------------------------------------


    # -----------------------------------------------------
    # 1. Redirect direct .html URLs to clean URLs
    #
    # services.html → services
    # about.html    → about
    # contact.html  → contact
    # -----------------------------------------------------

    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
    RewriteRule ^(.+)\.html$ /myanmargss/$1 [R=301,L,NE]


    # -----------------------------------------------------
    # 2. Internally rewrite clean URLs to .html files
    #
    # /services → services.html
    # /about    → about.html
    # -----------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/myanmargss/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]


    # -----------------------------------------------------
    # 3. Root URL
    #
    # /myanmargss/ → index.html
    # -----------------------------------------------------

    DirectoryIndex index.html

</IfModule>


# ---------------------------------------------------------
# CACHE CONTROL
# ---------------------------------------------------------

<IfModule mod_headers.c>

    # HTML should always revalidate.
    <FilesMatch "\.(html?)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Static assets: cache for 1 day and revalidate.
    <FilesMatch "\.(css|js|json|png|jpe?g|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>

</IfModule>


# ---------------------------------------------------------
# GZIP / DEFLATE
# ---------------------------------------------------------

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE \
        text/html \
        text/css \
        application/javascript \
        application/json \
        text/javascript \
        image/svg+xml

</IfModule>


# ---------------------------------------------------------
# OPTIONAL HTTPS REDIRECT
# Enable only after HTTPS is configured.
# ---------------------------------------------------------

# <IfModule mod_rewrite.c>
#     RewriteEngine On
#
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>